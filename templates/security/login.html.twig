{% extends 'base.html.twig' %}

{% block title %}Logowanie{% endblock %}

{% block body %}
<main class="min-h-screen flex items-center justify-center p-4">
    <div class="w-full max-w-sm">
        <div class="flex items-center gap-3 mb-6">
            <twig:Logo size="44" />
            <div>
                <div class="text-lg font-semibold leading-tight">Folwark FMS</div>
                <div class="text-sm text-antracyt-500">Zarządzanie gospodarstwem</div>
            </div>
        </div>

        <div class="card card-body">
            {% if error %}
                <div class="alert alert-danger mb-4" role="alert">{{ error.messageKey|trans(error.messageData, 'security') }}</div>
            {% endif %}

            {% if device %}
                <h1 class="text-base font-semibold mb-1">Witaj, {{ device.user.fullName }}</h1>
                <p class="text-sm text-antracyt-500 mb-4">Wpisz PIN tego urządzenia ({{ device.name }}).</p>
                <form method="post" action="{{ path('app_pin') }}" data-turbo="false">
                    <input type="hidden" name="_csrf_token" value="{{ csrf_token('pin') }}">
                    <div class="field">
                        <label class="label" for="pin">PIN</label>
                        <input class="input text-center text-2xl tracking-[0.5em]" id="pin" name="pin" type="password" inputmode="numeric" pattern="[0-9]*" minlength="4" maxlength="6" autocomplete="off" required autofocus>
                    </div>
                    <button class="btn btn-primary w-full" type="submit">Zaloguj</button>
                </form>
                <a class="block mt-4 text-sm" href="{{ path('app_login', {haslo: 1}) }}">Zaloguj e-mailem i hasłem</a>
            {% else %}
                <h1 class="text-base font-semibold mb-4">Zaloguj się</h1>
                <form method="post" action="{{ path('app_login') }}" data-turbo="false">
                    <input type="hidden" name="_csrf_token" data-controller="csrf-protection" value="{{ csrf_token('authenticate') }}">
                    <div class="field">
                        <label class="label" for="email">E-mail</label>
                        <input class="input" id="email" name="email" type="email" value="{{ last_username }}" autocomplete="email" required autofocus>
                    </div>
                    <div class="field">
                        <label class="label" for="password">Hasło</label>
                        <input class="input" id="password" name="password" type="password" autocomplete="current-password" required>
                    </div>
                    <label class="inline-flex items-center gap-3 mb-4 cursor-pointer text-sm" style="min-height:40px">
                        <input class="checkbox" type="checkbox" name="_remember_me" value="1">
                        Nie wylogowuj mnie na tym urządzeniu
                    </label>
                    <button class="btn btn-primary w-full" type="submit">Zaloguj</button>
                </form>
            {% endif %}
        </div>
        <p class="mt-4 text-sm text-center">Nie masz konta? <a href="{{ path('app_register') }}">Zarejestruj się</a></p>
    </div>
</main>
{% endblock %}
