{# Szkielety dla kontrolerów JS (okno, podgląd, zakładki) – kopiowane z <template>, żeby wyglądały tak samo jak w Twig. #}
<template id="skeleton-modal"><twig:Skeleton variant="form" count="4" /></template>
<template id="skeleton-preview"><twig:Skeleton variant="document" count="3" /></template>
<template id="skeleton-tab"><twig:Skeleton variant="table" count="4" data-tab-skeleton /></template>
<template id="skeleton-search"><twig:Skeleton variant="rows" count="4" /></template>
