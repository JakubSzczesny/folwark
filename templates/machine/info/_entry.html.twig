<article class="card card-body" id="wpis-{{ entry.id }}">
    <div class="flex items-start justify-between gap-2">
        <div class="min-w-0">
            <h4 class="font-semibold">{{ entry.name }}</h4>
            {% set meta = [entry.catalogNumber ? 'nr ' ~ entry.catalogNumber, entry.manufacturer, entry.sizeQuantity]|filter(v => v) %}
            {% if meta is not empty %}<p class="text-sm text-antracyt-500">{{ meta|join(' · ') }}</p>{% endif %}
        </div>
        {% if is_granted('MACHINE_EDIT') %}
            <a href="{{ path('app_machine_info_entry_edit', {id: entry.id}) }}" data-turbo-frame="modal" class="btn btn-ghost btn-icon btn-sm" aria-label="Edytuj wpis {{ entry.name }}">{{ ux_icon('lucide:pencil') }}</a>
        {% endif %}
    </div>
    {% if entry.notes %}<p class="text-sm whitespace-pre-line mt-2">{{ entry.notes }}</p>{% endif %}

    {% set photos = entry.photos %}
    {% if photos is not empty %}
        <div class="flex flex-wrap gap-2 mt-3">
            {% for photo in photos %}
                <a href="{{ path('app_machine_info_thumbnail', {id: photo.id, filter: 'photo'}) }}" target="_blank" rel="noopener" title="{{ photo.label }}">
                    <img src="{{ path('app_machine_info_thumbnail', {id: photo.id, filter: 'thumb'}) }}" alt="{{ photo.label }}" width="72" height="72" loading="lazy" class="rounded-ui object-cover bg-szary-100" style="width:72px;height:72px">
                </a>
            {% endfor %}
        </div>
    {% endif %}

    {% set files = entry.files %}
    {% set links = entry.links %}
    {% if files is not empty or links is not empty %}
        <ul class="mt-3 space-y-1 text-sm">
            {% for file in files %}
                <li><a href="{{ path('app_machine_info_attachment', {id: file.id}) }}" target="_blank" rel="noopener" class="inline-flex items-center gap-1.5">{{ ux_icon('lucide:file-text', {width: 16, height: 16}) }}{{ file.label }}</a></li>
            {% endfor %}
            {% for link in links %}
                <li><a href="{{ link.location }}" target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-1.5">{{ ux_icon('lucide:external-link', {width: 16, height: 16}) }}{{ link.label }}</a></li>
            {% endfor %}
        </ul>
    {% endif %}
</article>
