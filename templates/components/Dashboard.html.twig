<div {{ attributes }} data-poll="delay(20000)|$render">
    {% set widgets = this.widgets %}
    {% set token = csrf_token('dashboard') %}
    {% if widgets is empty %}
        <div class="card mb-6"><twig:EmptyState text="Pulpit jest pusty. Kliknij „Dostosuj pulpit” i dodaj widżety." /></div>
    {% else %}
        <div class="grid gap-6 mb-6 lg:grid-cols-2">
            {% for widget in widgets %}
                <div class="dashboard-widget {{ widget.key in ['invoices', 'orders', 'calendar'] ? '' : 'lg:col-span-2' }}" data-widget="{{ widget.key }}">
                    <div class="dashboard-tools">
                        <span class="text-sm font-semibold">{{ widget.label }}</span>
                        <span class="ml-auto flex gap-1">
                            {% if not loop.first %}
                                <form method="post" action="{{ path('app_dashboard_widget_move', {key: widget.key, direction: 'w-gore'}) }}">
                                    <input type="hidden" name="_token" value="{{ token }}">
                                    <button type="submit" class="btn btn-ghost btn-icon btn-sm" aria-label="Przesuń „{{ widget.label }}” wyżej" title="Wyżej">{{ ux_icon('lucide:arrow-up') }}</button>
                                </form>
                            {% endif %}
                            {% if not loop.last %}
                                <form method="post" action="{{ path('app_dashboard_widget_move', {key: widget.key, direction: 'w-dol'}) }}">
                                    <input type="hidden" name="_token" value="{{ token }}">
                                    <button type="submit" class="btn btn-ghost btn-icon btn-sm" aria-label="Przesuń „{{ widget.label }}” niżej" title="Niżej">{{ ux_icon('lucide:arrow-down') }}</button>
                                </form>
                            {% endif %}
                            <form method="post" action="{{ path('app_dashboard_widget_remove', {key: widget.key}) }}">
                                <input type="hidden" name="_token" value="{{ token }}">
                                <button type="submit" class="btn btn-ghost btn-icon btn-sm text-danger" aria-label="Usuń „{{ widget.label }}” z pulpitu" title="Usuń z pulpitu">{{ ux_icon('lucide:x') }}</button>
                            </form>
                        </span>
                    </div>
                    {{ include('dashboard/widget/' ~ widget.key ~ '.html.twig') }}
                </div>
            {% endfor %}
        </div>
    {% endif %}

    <p class="text-xs text-antracyt-500">Odświeżono {{ this.refreshedAt|date('H:i:s') }}</p>
</div>
