{% extends modal ? 'calendar/_frame.html.twig' : 'layout.html.twig' %}

{% block title %}{{ title }} · Kalendarz{% endblock %}
{% block active_menu %}calendar{% endblock %}

{% block modal %}
    <twig:Modal title="{{ title }}">
        {{ include('calendar/_form.html.twig') }}
    </twig:Modal>
{% endblock %}

{% block content %}
    <twig:PageHeader title="{{ title }}" back="{{ path('app_calendar_index', {miesiac: event.startDate ? event.startDate|date('Y-m')}) }}" />
    <div class="card card-body max-w-2xl">
        {{ include('calendar/_form.html.twig') }}
    </div>
{% endblock %}
