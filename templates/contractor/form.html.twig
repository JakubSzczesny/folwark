{% extends 'layout.html.twig' %}

{% set title = contractor.id ? 'Edycja: ' ~ contractor.displayName : 'Nowy kontrahent' %}
{% block title %}{{ title }}{% endblock %}
{% block active_menu %}contractors{% endblock %}

{% block content %}
    <twig:PageHeader title="{{ title }}" back="{{ contractor.id ? path('app_contractor_show', {id: contractor.id}) : path('app_contractor_index') }}" />

    <div class="card card-body max-w-3xl">
        {% if contractor.id and contractor.nip and not contractor.updateLocked %}
            <div class="alert alert-info mb-4">Zmiana nazwy lub adresu założy blokadę – dane z kolejnych faktur nie będą ich nadpisywać. Blokadę można później zdjąć.</div>
        {% endif %}
        {{ form_start(form) }}
            <div class="form-grid">
                {{ form_row(form.name) }}
                {{ form_row(form.shortName) }}
                {% if form.nip is defined %}{{ form_row(form.nip) }}{% endif %}
                {{ form_row(form.street) }}
                {{ form_row(form.postalCode) }}
                {{ form_row(form.city) }}
                {{ form_row(form.country) }}
                {{ form_row(form.email) }}
                {{ form_row(form.phone) }}
                {{ form_row(form.contactPerson) }}
                {{ form_row(form.deliveryDays) }}
            </div>
            {{ form_rest(form) }}
            <div class="flex gap-2">
                <button type="submit" class="btn btn-primary">Zapisz</button>
                <a href="{{ contractor.id ? path('app_contractor_show', {id: contractor.id}) : path('app_contractor_index') }}" class="btn btn-ghost">Anuluj</a>
            </div>
        {{ form_end(form) }}
    </div>
{% endblock %}
