{% use 'form_div_layout.html.twig' %}

{% block form_row %}
    {% set row_attr = row_attr|merge({class: ('field ' ~ (row_attr.class|default('')))|trim}) %}
    <div {% with {attr: row_attr} %}{{ block('attributes') }}{% endwith %}>
        {{ form_label(form) }}
        {{ form_widget(form) }}
        {{ form_help(form) }}
        {{ form_errors(form) }}
    </div>
{% endblock %}

{% block checkbox_row %}
    {% set row_attr = row_attr|merge({class: ('field ' ~ (row_attr.class|default('')))|trim}) %}
    <div {% with {attr: row_attr} %}{{ block('attributes') }}{% endwith %}>
        <label class="inline-flex items-center gap-3 cursor-pointer" style="min-height:40px">
            {{ form_widget(form) }}
            <span>{{ label is not same as(false) ? (label ?: name|humanize) }}</span>
        </label>
        {{ form_help(form) }}
        {{ form_errors(form) }}
    </div>
{% endblock %}

{% block form_label %}
    {% if label is not same as(false) %}
        {% set label_attr = label_attr|merge({class: ('label ' ~ (label_attr.class|default('')))|trim}) %}
        {{ parent() }}
    {% endif %}
{% endblock %}

{% block form_label_content %}
    {{- parent() -}}
    {%- if required and label is not same as(false) and not (compound is defined and compound) %}<span class="text-blad" aria-hidden="true"> *</span>{% endif -%}
{% endblock %}

{% block form_widget_simple %}
    {% if type is not defined or type not in ['file', 'hidden', 'range', 'color'] %}
        {% set attr = attr|merge({class: ('input ' ~ (attr.class|default('')))|trim}) %}
    {% endif %}
    {{ parent() }}
{% endblock %}

{% block textarea_widget %}
    {% set attr = attr|merge({class: ('textarea ' ~ (attr.class|default('')))|trim}) %}
    {{ parent() }}
{% endblock %}

{% block choice_widget_collapsed %}
    {% set attr = attr|merge({class: ('select ' ~ (attr.class|default('')))|trim}) %}
    {{ parent() }}
{% endblock %}

{% block choice_widget_expanded %}
    <div {{ block('widget_container_attributes') }} class="flex flex-wrap gap-x-5 gap-y-2">
        {% for child in form %}
            <label class="inline-flex items-center gap-2 cursor-pointer" style="min-height:40px">
                {{ form_widget(child) }}
                <span>{{ child.vars.label }}</span>
            </label>
        {% endfor %}
    </div>
{% endblock %}

{% block checkbox_widget %}
    {% set attr = attr|merge({class: ('checkbox ' ~ (attr.class|default('')))|trim}) %}
    {{ parent() }}
{% endblock %}

{% block radio_widget %}
    {% set attr = attr|merge({class: ('checkbox ' ~ (attr.class|default('')))|trim}) %}
    {{ parent() }}
{% endblock %}

{% block form_errors %}
    {% if errors|length > 0 %}
        {% for error in errors %}
            <p class="form-error">{{ error.message }}</p>
        {% endfor %}
    {% endif %}
{% endblock %}

{% block form_help %}
    {% if help is not empty %}
        <p id="{{ id }}_help" class="help">{{ help|trans(help_translation_parameters, translation_domain) }}</p>
    {% endif %}
{% endblock %}

{% block button_widget %}
    {% set attr = attr|merge({class: (attr.class|default('btn btn-secondary'))|trim}) %}
    {{ parent() }}
{% endblock %}

{% block submit_widget %}
    {% set attr = attr|merge({class: (attr.class|default('btn btn-primary'))|trim}) %}
    {{ parent() }}
{% endblock %}
