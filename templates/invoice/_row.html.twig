{% import '_partials/macros.html.twig' as m %}
<tr id="invoice-row-{{ invoice.id }}"
    class="{{ invoice.unread ? 'is-unread' }}"
    data-table-nav-target="row"
    data-preview-url="{{ path('app_invoice_preview', {id: invoice.id}) }}"
    data-href="{{ path('app_invoice_show', {id: invoice.id}) }}"
    data-action="click->table-nav#click">
    <td class="w-4 !pr-0 row-select">
        {% if is_granted('INVOICE_MANAGE') %}
            <input type="checkbox" class="checkbox" name="ids[]" value="{{ invoice.id }}" form="invoice-bulk" data-bulk-target="item" data-action="click->bulk#toggle" aria-label="Zaznacz fakturę {{ invoice.number }}">
        {% endif %}
        {% if invoice.unread %}<span class="dot-new" title="Nowa"></span><span class="sr-only">Nowa</span>{% endif %}
        <template data-context-menu>
            {% import '_partials/context_menu.html.twig' as cm %}
            {% if is_granted('INVOICE_MANAGE') %}
                {% if invoice.cost %}
                    {% if invoice.status.value != 'skipped' %}{{ cm.link(path('app_invoice_assign', {id: invoice.id}), 'Przypisz towary', 'package-check') }}{% endif %}
                    {{ cm.link(path('app_invoice_cost_only', {id: invoice.id, z: 'lista'}), 'Tylko koszt…', null, 'modal') }}
                {% else %}
                    {{ cm.link(path('app_invoice_contract', {id: invoice.id, z: 'lista'}), 'Przypisz umowę…', 'file-signature', 'modal') }}
                {% endif %}
                {% if invoice.paid %}
                    {{ cm.post(path('app_invoice_unpaid', {id: invoice.id, z: 'lista'}), 'Cofnij opłacenie', 'invoice') }}
                {% else %}
                    {{ cm.post(path('app_invoice_paid', {id: invoice.id, z: 'lista'}), 'Oznacz jako opłaconą', 'invoice', 'check') }}
                    {% if invoice.cost %}
                        {% if bspay_enabled() %}{{ cm.bspay(path('app_invoice_transfer_json', {id: invoice.id})) }}{% endif %}
                        {{ cm.link(path('app_invoice_transfer', {id: invoice.id}), 'Dane do przelewu', 'banknote', 'modal') }}
                    {% endif %}
                {% endif %}
                {% if invoice.cost %}
                    {% if invoice.status.value == 'skipped' %}
                        {{ cm.post(path('app_invoice_restore', {id: invoice.id, z: 'lista'}), 'Przywróć', 'invoice') }}
                    {% else %}
                        {{ cm.post(path('app_invoice_skip', {id: invoice.id, z: 'lista'}), 'Pomiń fakturę', 'invoice') }}
                    {% endif %}
                {% endif %}
                {{ cm.separator() }}
            {% endif %}
            <a href="{{ path('app_invoice_pdf', {id: invoice.id}) }}" class="dropdown-item" role="menuitem" data-turbo="false">{{ ux_icon('lucide:download', {width: 16, height: 16}) }}Pobierz PDF</a>
            <a href="{{ path('app_invoice_xml', {id: invoice.id}) }}" class="dropdown-item" role="menuitem" data-turbo="false">{{ ux_icon('lucide:file-code', {width: 16, height: 16}) }}Pobierz XML</a>
        </template>
    </td>
    <td data-label="Data wystawienia" class="tabular-nums whitespace-nowrap">{{ invoice.issueDate|pl_date }}</td>
    <td class="card-title-cell">
        <a href="{{ path('app_invoice_show', {id: invoice.id}) }}" class="text-tekst hover:text-zielen-600">{{ invoice.number }}</a>
        {% if invoice.correction %}<twig:Badge tone="info">Korekta</twig:Badge>{% endif %}
        <span class="kind-label"><twig:Badge tone="neutral">{{ invoice.kind.label }}</twig:Badge></span>
    </td>
    <td data-label="Kontrahent" class="max-w-[280px] truncate" title="{{ invoice.contractorName }}">{% if invoice.contractor and is_granted('CONTRACTOR_VIEW') %}<a href="{{ path('app_contractor_show', {id: invoice.contractor.id}) }}" class="text-tekst hover:text-zielen-600 hover:underline">{{ invoice.contractorLabel }}</a>{% else %}{{ invoice.contractorLabel }}{% endif %}</td>
    <td data-label="Netto" class="num">{{ invoice.net|money(invoice.currency) }}</td>
    <td data-label="Brutto" class="num">{{ invoice.gross|money(invoice.currency) }}</td>
    <td data-label="Termin płatności" class="whitespace-nowrap">{{ m.deadline(invoice.paymentDue, 3, invoice.paid or not invoice.cost) }}</td>
    <td data-label="Status" class="whitespace-nowrap">
        <twig:Badge tone="{{ invoice.status.tone }}">{{ invoice.status.label }}</twig:Badge>
        {% if invoice.paid %}<twig:Badge tone="positive">Opłacona</twig:Badge>{% endif %}
        {% set unassigned = unassigned_counts is defined ? (unassigned_counts[invoice.id] ?? 0) : invoice.countUnassignedItems %}
        {% if unassigned > 0 %}<twig:Badge tone="warning" title="{{ unassigned }} {{ unassigned|plural('pozycja nie ma', 'pozycje nie mają', 'pozycji nie ma') }} przypisanego towaru z kartoteki">{{ ux_icon('lucide:package-x', {width: 14, height: 14}) }}Bez towaru: {{ unassigned }}</twig:Badge>{% endif %}
    </td>
</tr>
