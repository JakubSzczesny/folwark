{# Zakładka „Korespondencja”: maile od i do adresów kontrahenta ze skrzynki Gmail gospodarstwa. #}
<section class="card" data-mail-tab>
    <div class="card-header">
        <h2 class="card-title">Korespondencja</h2>
        {% if contractor.emailAddresses is not empty %}
            <span class="text-sm text-antracyt-500 truncate">{{ contractor.emailAddresses|join(', ') }}</span>
        {% endif %}
    </div>
    {% if contractor.emailAddresses is empty %}
        <twig:EmptyState
            text="Kontrahent nie ma adresu e-mail – uzupełnij go, żeby zobaczyć korespondencję."
            icon="mail"
            actionLabel="{{ is_granted('CONTRACTOR_EDIT') ? 'Uzupełnij e-mail' : null }}"
            actionUrl="{{ is_granted('CONTRACTOR_EDIT') ? path('app_contractor_edit', {id: contractor.id}) : null }}" />
    {% elseif mail_error %}
        <div class="p-4">
            <div class="alert alert-danger" role="alert">
                {{ mail_error }}
                {% if is_granted('SETTINGS') %}<a href="{{ path('app_settings_gmail') }}">Ustawienia Gmaila</a>{% endif %}
            </div>
        </div>
    {% elseif mails.total == 0 %}
        <twig:EmptyState text="Brak wiadomości od i do tego kontrahenta w skrzynce." icon="mail" />
    {% else %}
        {{ include('_partials/pagination.html.twig', {pager: mails, top: true}) }}
        <ul class="divide-y divide-szary-200">
            {% for mail in mails.items %}
                <li>
                    <a href="{{ path('app_contractor_mail', {id: contractor.id, uid: mail.uid}) }}" class="flex items-center gap-3 px-4 py-3 text-tekst hover:bg-szary-100 hover:text-tekst">
                        <span class="shrink-0 {{ mail.incoming ? 'text-zielen-600' : 'text-antracyt-500' }}" title="{{ mail.incoming ? 'Odebrana' : 'Wysłana' }}">
                            {{ ux_icon(mail.incoming ? 'lucide:arrow-down-left' : 'lucide:arrow-up-right') }}
                        </span>
                        <span class="flex-1 min-w-0">
                            <span class="block truncate text-sm font-semibold">{{ mail.subject }}</span>
                            <span class="block truncate text-xs text-antracyt-500">
                                {% if mail.incoming %}od {{ mail.from }}{% else %}do {{ mail.to|join(', ') }}{% endif %}
                            </span>
                        </span>
                        {% if mail.hasAttachments %}<span class="shrink-0 text-antracyt-500" title="Z załącznikami">{{ ux_icon('lucide:paperclip') }}</span>{% endif %}
                        <span class="shrink-0 text-sm whitespace-nowrap tabular-nums">{{ mail.date ? mail.date|pl_datetime : '—' }}</span>
                    </a>
                </li>
            {% endfor %}
        </ul>
        {{ include('_partials/pagination.html.twig', {pager: mails}) }}
    {% endif %}
</section>
