{# Pozycje menu pod prawym przyciskiem myszy (wnętrze <template data-context-menu>). #}

{% macro link(url, label, icon = null, frame = null) %}
    <a href="{{ url }}" class="dropdown-item" role="menuitem" {% if frame %}data-turbo-frame="{{ frame }}"{% endif %}>{% if icon %}{{ ux_icon('lucide:' ~ icon, {width: 16, height: 16}) }}{% endif %}{{ label }}</a>
{% endmacro %}

{% macro post(url, label, token_id, icon = null, confirm = null) %}
    <form method="post" action="{{ url }}" {% if confirm %}data-turbo-confirm="{{ confirm }}"{% endif %}>
        <input type="hidden" name="_token" value="{{ csrf_token(token_id) }}">
        <button type="submit" class="dropdown-item" role="menuitem">{% if icon %}{{ ux_icon('lucide:' ~ icon, {width: 16, height: 16}) }}{% endif %}{{ label }}</button>
    </form>
{% endmacro %}

{% macro bspay(url) %}
    <button type="button" class="dropdown-item" role="menuitem" data-controller="bspay-send" data-action="bspay-send#send" data-bspay-send-url-value="{{ url }}" data-bspay-send-bank-url-value="{{ bspay_bank_url() }}">{{ ux_icon('lucide:external-link', {width: 16, height: 16}) }}Uzupełnij w BS</button>
{% endmacro %}

{% macro separator() %}
    <hr>
{% endmacro %}

{# Pozycja menu bocznego: wyłączenie modułu (tylko z uprawnieniem SETTINGS). #}
{% macro module(key) %}
    <template data-context-menu>
        <form method="post" action="{{ path('app_settings_module_toggle', {key: key, state: 'wylacz'}) }}" data-turbo-confirm="Wyłączyć moduł „{{ module_label(key) }}”? Dane zostaną – moduł można z powrotem włączyć w Ustawienia → Moduły.">
            <input type="hidden" name="_token" value="{{ csrf_token('modules') }}">
            <button type="submit" class="dropdown-item" role="menuitem">{{ ux_icon('lucide:eye-off', {width: 16, height: 16}) }}Wyłącz moduł „{{ module_label(key) }}”</button>
        </form>
        <a href="{{ path('app_settings_modules') }}" class="dropdown-item" role="menuitem">{{ ux_icon('lucide:settings', {width: 16, height: 16}) }}Ustawienia modułów</a>
    </template>
{% endmacro %}
