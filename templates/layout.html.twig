{% extends 'base.html.twig' %}

{% set farm = current_farm() %}
{% set menu = farm ? app_menu() : [] %}
{% set active_menu = block('active_menu') is defined ? block('active_menu')|trim : '' %}
{% set collapsed = app.request.cookies.get('sidebar') == 'collapsed' %}

{% block body %}
{% if farm %}
<div data-controller="sidebar" class="{{ collapsed ? 'is-collapsed' }}" data-action="keydown@window->sidebar#closeOnEscape">
    <div data-sidebar-target="backdrop" class="fixed inset-0 z-40 bg-antracyt-900/50 lg:hidden" data-action="click->sidebar#close" hidden></div>

    <aside data-sidebar-target="drawer" class="app-sidebar" aria-label="Menu główne">
        <div class="flex items-center justify-between gap-2 px-3" style="height: 56px">
            <a href="{{ path('app_dashboard') }}" class="flex items-center gap-2 text-white hover:text-white font-semibold min-w-0">
                <twig:Logo size="32" />
                <span class="sidebar-label truncate">Folwark</span>
            </a>
            <button type="button" class="sidebar-label rounded-ui p-2 text-antracyt-300 hover:text-white hover:bg-antracyt-700 hidden lg:inline-flex" data-action="sidebar#toggleCollapsed" title="Zwiń menu" aria-label="Zwiń menu">
                {{ ux_icon('lucide:panel-left-close') }}
            </button>
            <button type="button" class="rounded-ui p-2 text-antracyt-300 hover:text-white hover:bg-antracyt-700 lg:hidden" data-action="sidebar#close" aria-label="Zamknij menu">
                {{ ux_icon('lucide:x') }}
            </button>
        </div>

        <nav class="flex-1 overflow-y-auto px-2 pb-4 space-y-0.5">
            {% for item in menu %}
                {% if item.separator %}<hr class="my-3 border-antracyt-700">{% endif %}
                {% set item_active = active_menu == item.key or item.children|filter(c => c.key == active_menu)|length > 0 %}
                <a href="{{ item.url }}" class="sidebar-link {{ item_active ? 'is-active' }}" title="{{ item.label }}" {% if item_active %}aria-current="page"{% endif %}>
                    <span class="shrink-0">{{ ux_icon('lucide:' ~ item.icon) }}</span>
                    <span class="sidebar-label flex-1">{{ item.label }}</span>
                    {% if item.badge > 0 %}<span class="count sidebar-badge-text">{{ item.badge }}</span>{% endif %}
                </a>
                {% if item.children|length > 0 and (item.route is not null or item.children|length > 1) %}
                    <div class="sidebar-sub space-y-0.5">
                        {% for child in item.children %}
                            <a href="{{ child.url }}" class="sidebar-sublink {{ active_menu == child.key ? 'is-active' }}">{{ child.label }}</a>
                        {% endfor %}
                    </div>
                {% endif %}
            {% endfor %}
        </nav>

        <div class="flex items-center justify-between gap-2 border-t border-antracyt-700 px-3" style="min-height:44px">
            <span class="sidebar-label text-[11px] tracking-wide text-antracyt-300">© {{ 'now'|date('Y') }} JS</span>
            <button type="button" class="hidden lg:inline-flex rounded-ui p-2 text-antracyt-300 hover:text-white hover:bg-antracyt-700 mx-auto lg:mx-0" data-action="sidebar#toggleCollapsed" title="Rozwiń / zwiń menu" aria-label="Rozwiń lub zwiń menu">
                {{ ux_icon('lucide:panel-left') }}
            </button>
        </div>
    </aside>

    <div class="app-main">
        <header class="app-topbar">
            <button type="button" class="btn btn-ghost btn-icon lg:hidden" data-action="sidebar#open" aria-label="Otwórz menu">
                {{ ux_icon('lucide:menu') }}
            </button>

            <div class="flex-1 min-w-0" data-controller="search" data-search-url-value="{{ path('app_search') }}" data-action="keydown@window->search#shortcut">
                <button type="button" class="flex items-center gap-2 w-full max-w-md rounded-ui border border-szary-200 bg-szary-50 px-3 text-sm text-antracyt-500 hover:border-antracyt-300" style="min-height:40px" data-action="search#open" aria-label="Szukaj">
                    {{ ux_icon('lucide:search') }}
                    <span class="flex-1 text-left truncate hidden sm:block">Szukaj faktur, kontrahentów, maszyn…</span>
                    <span class="kbd hidden md:inline-flex">Ctrl K</span>
                </button>

                <dialog data-search-target="dialog" class="m-0 mx-auto mt-[10vh] w-[calc(100%-2rem)] max-w-xl rounded-ui border border-szary-200 bg-white p-0 backdrop:bg-antracyt-900/40" data-action="click->search#closeOnBackdrop" aria-label="Wyszukiwarka">
                    <div class="flex items-center gap-2 border-b border-szary-200 px-3">
                        <span class="search-icon text-antracyt-500">{{ ux_icon('lucide:search') }}</span><span class="search-spinner spinner text-zielen-600" aria-hidden="true"></span>
                        <input type="search" class="flex-1 border-0 py-3 text-base outline-none" placeholder="Wpisz numer faktury, NIP, nazwę, nr rej.…" autocomplete="off" data-search-target="input" data-action="input->search#query keydown->search#navigate">
                        <span class="kbd">Esc</span>
                    </div>
                    <div data-search-target="results" class="max-h-[60vh] overflow-y-auto" data-action="click->search#choose">
                        <p class="px-4 py-6 text-sm text-antracyt-500">Wpisz co najmniej 2 znaki.</p>
                    </div>
                </dialog>
            </div>

            {{ include('_partials/farm_switcher.html.twig') }}

            {% set unread = menu|filter(i => i.key == 'notifications')|first.badge|default(0) %}
            <div class="relative" data-controller="dropdown" data-action="keydown@window->dropdown#hideOnEscape">
                <button type="button" class="btn btn-ghost btn-icon relative" data-dropdown-target="button" data-action="dropdown#toggle" aria-haspopup="true" aria-expanded="false" aria-label="Powiadomienia{% if unread > 0 %}, nieprzeczytane: {{ unread }}{% endif %}">
                    {{ ux_icon('lucide:bell') }}
                    {% if unread > 0 %}<span class="count absolute top-1 right-0">{{ unread }}</span>{% endif %}
                </button>
                <div data-dropdown-target="menu" class="dropdown right-0 w-[min(380px,calc(100vw-1.5rem))]" hidden>
                    <turbo-frame id="notification-bell" src="{{ path('app_notification_bell') }}" loading="lazy">
                        <p class="flex items-center gap-2 px-4 py-6 text-sm text-antracyt-500"><span class="spinner text-zielen-600" aria-hidden="true"></span> Wczytywanie…</p>
                    </turbo-frame>
                </div>
            </div>

            {{ include('_partials/user_menu.html.twig') }}
        </header>

        <main class="app-content" id="main">
            {{ include('_partials/flashes.html.twig') }}
            {% block content %}{% endblock %}
        </main>
    </div>

    <nav class="app-bottombar" aria-label="Skróty">
        {% for item in app_mobile_menu() %}
            <a href="{{ item.url }}" class="{{ active_menu == item.key ? 'is-active' }}">
                {{ ux_icon('lucide:' ~ item.icon, {width: 22, height: 22}) }}
                <span>{{ item.label }}</span>
                {% if item.badge > 0 %}<span class="count">{{ item.badge }}</span>{% endif %}
            </a>
        {% endfor %}
    </nav>
</div>

<div data-controller="modal">
    <dialog data-modal-target="dialog" class="m-0 mx-auto mt-[5vh] w-[calc(100%-2rem)] max-w-2xl max-h-[90vh] overflow-visible rounded-ui border border-szary-200 bg-white p-0 backdrop:bg-antracyt-900/40" data-action="click->modal#closeOnBackdrop">
        <turbo-frame id="modal" data-modal-target="frame"></turbo-frame>
    </dialog>
</div>
{% else %}
<div class="min-h-screen flex flex-col">
    <header class="app-topbar">
        <a href="{{ path('app_farm_index') }}" class="flex items-center gap-2 font-semibold text-tekst hover:text-tekst">
            <twig:Logo size="32" />
            <span>Folwark</span>
        </a>
        <span class="flex-1"></span>
        {% if user_memberships() is not empty %}{{ include('_partials/farm_switcher.html.twig') }}{% endif %}
        {{ include('_partials/user_menu.html.twig') }}
    </header>
    <main class="flex-1 w-full max-w-5xl mx-auto p-4 md:p-8" id="main">
        {{ include('_partials/flashes.html.twig') }}
        {% block content_without_farm %}{{ block('content') }}{% endblock %}
    </main>
</div>
{% endif %}
{% endblock %}
