{% extends 'layout.html.twig' %}

{% block title %}Użytkownicy{% endblock %}
{% block active_menu %}settings{% endblock %}

{% block content %}
    <twig:PageHeader title="Użytkownicy i role" back="{{ path('app_settings') }}">
        <a href="{{ path('app_settings_user_new') }}" class="btn btn-primary">{{ ux_icon('lucide:plus') }} Dodaj użytkownika</a>
    </twig:PageHeader>

    <div class="card">
        <div class="table-wrap">
            <table class="table table-cards" data-controller="table-nav" data-action="keydown@window->table-nav#keydown">
                <thead>
                    <tr><th>Imię i nazwisko</th><th>E-mail</th><th>Rola</th><th>Status</th><th>Ostatnie logowanie</th></tr>
                </thead>
                <tbody>
                    {% for user in users %}
                        <tr data-table-nav-target="row" data-href="{{ path('app_settings_user_edit', {id: user.id}) }}" data-action="click->table-nav#click">
                            <td class="card-title-cell"><a href="{{ path('app_settings_user_edit', {id: user.id}) }}">{{ user.fullName }}</a></td>
                            <td data-label="E-mail">{{ user.email }}</td>
                            <td data-label="Rola">{{ user.role.label }}</td>
                            <td data-label="Status">
                                {% if user.active %}<twig:Badge tone="positive">Aktywne</twig:Badge>{% else %}<twig:Badge tone="neutral">Wyłączone</twig:Badge>{% endif %}
                            </td>
                            <td data-label="Ostatnie logowanie" class="tabular-nums">{{ user.lastLoginAt ? user.lastLoginAt|pl_datetime : '—' }}</td>
                        </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
    </div>
{% endblock %}
