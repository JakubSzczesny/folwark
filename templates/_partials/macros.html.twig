{# Nagłówek kolumny z sortowaniem: klik – tylko po tej kolumnie, Shift + klik – dodatkowo po niej (maks. 2 kolumny). #}
{% macro sort_th(label, field, sort, class = '') %}
    {% if sort is null %}
        <th class="{{ class }}">{{ label }}</th>
    {% else %}
        {% set route = app.request.attributes.get('_route') %}
        {% set params = app.request.attributes.get('_route_params')|merge(app.request.query.all)|merge({strona: null}) %}
        {% set position = sort.position(field) %}
        {% set direction = sort.directionOf(field) %}
        <th class="{{ class }}" {% if position == 1 %}aria-sort="{{ direction == 'asc' ? 'ascending' : 'descending' }}"{% endif %}>
            <a href="{{ path(route, params|merge(sort.queryFor(field))) }}"
               class="sort-link {{ position ? 'is-active' }}"
               data-controller="sort-link"
               data-sort-link-add-value="{{ path(route, params|merge(sort.queryFor(field, true))) }}"
               data-action="click->sort-link#click"
               title="Sortuj · Shift + klik: sortuj dodatkowo po tej kolumnie">
                {{ label }}
                {% if direction %}
                    {{ ux_icon(direction == 'asc' ? 'lucide:arrow-up' : 'lucide:arrow-down', {width: 14, height: 14}) }}
                    {% if sort.multi %}<span class="sort-order" aria-label="kolejność sortowania {{ position }}">{{ position }}</span>{% endif %}
                {% endif %}
            </a>
        </th>
    {% endif %}
{% endmacro %}

{# Ukryte pola sortowania w formularzu filtrów – zmiana filtra nie gubi sortowania. #}
{% macro sort_fields(sort) %}
    {% for key, value in sort.toQuery %}<input type="hidden" name="{{ key }}" value="{{ value }}">{% endfor %}
{% endmacro %}

{% macro deadline(date, warn_days = 30, settled = false) %}
    {% if date %}
        {% set tone = settled ? null : deadline_tone(date, warn_days) %}
        <span class="{{ tone ? 'tone-' ~ tone }}" {% if tone %}title="{{ days_label(days_left(date)) }}"{% endif %}>{{ date|pl_date }}</span>
        {% if tone %}<span class="sr-only">({{ days_label(days_left(date)) }})</span>{% endif %}
    {% else %}
        <span class="text-antracyt-500">—</span>
    {% endif %}
{% endmacro %}

{% macro post_button(url, label, token_id, class = 'btn btn-secondary', confirm = null, icon = null) %}
    <form method="post" action="{{ url }}" class="inline" {% if confirm %}data-turbo-confirm="{{ confirm }}"{% endif %}>
        <input type="hidden" name="_token" value="{{ csrf_token(token_id) }}">
        <button type="submit" class="{{ class }}">{% if icon %}{{ ux_icon('lucide:' ~ icon) }}{% endif %}{{ label }}</button>
    </form>
{% endmacro %}

{# Mini-wykres liniowy (np. 12 miesięcy) – sam SVG, bez biblioteki. #}
{% macro sparkline(values, width = 96, height = 32) %}
    {% set max = max(values) %}
    {% set min = min(values) %}
    {% set span = max - min ?: 1 %}
    {% set step = values|length > 1 ? width / (values|length - 1) : width %}
    {% set points = [] %}
    {% for value in values %}
        {% set points = points|merge([(loop.index0 * step)|round(1) ~ ',' ~ (height - 2 - (value - min) / span * (height - 4))|round(1)]) %}
    {% endfor %}
    <svg class="sparkline shrink-0 text-zielen-600" width="{{ width }}" height="{{ height }}" viewBox="0 0 {{ width }} {{ height }}" aria-hidden="true">
        <polyline points="{{ points|join(' ') }}" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linejoin="round" stroke-linecap="round"/>
    </svg>
{% endmacro %}
