{# back – adres powrotu; backLabel – dokąd („Faktury”, „Ustawienia”), domyślnie „Wróć”. #}
{% props title, subtitle = null, back = null, backLabel = 'Wróć' %}
<div {{ attributes.defaults({class: 'page-header'}) }}>
    <div class="min-w-0">
        {% if back %}
            <a href="{{ back }}" class="inline-flex items-center gap-1 text-sm text-antracyt-500 hover:text-tekst mb-1">{{ ux_icon('lucide:arrow-left', {width: 16, height: 16}) }} {{ backLabel }}</a>
        {% endif %}
        <h1 class="page-title">{{ title }}</h1>
        {% if subtitle %}<p class="page-subtitle">{{ subtitle }}</p>{% endif %}
    </div>
    <div class="flex flex-wrap items-center gap-2">{% block content %}{% endblock %}</div>
</div>
