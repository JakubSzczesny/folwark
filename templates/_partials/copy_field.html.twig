{# Pole z wartością i przyciskiem „Kopiuj”. #}
{% macro field(label, value, display = null) %}
    <div class="flex items-center justify-between gap-3 border-b border-szary-100 py-2">
        <div class="min-w-0">
            <div class="text-xs text-antracyt-500">{{ label }}</div>
            <div class="font-semibold break-words tabular-nums">{{ display ?? value ?? '—' }}</div>
        </div>
        {% if value %}
            <button type="button" class="btn btn-ghost btn-icon btn-sm copy-button shrink-0" data-controller="copy" data-copy-text-value="{{ value }}" data-action="copy#copy" aria-label="Kopiuj: {{ label }}" title="Kopiuj">{{ ux_icon('lucide:copy') }}</button>
        {% endif %}
    </div>
{% endmacro %}
