{% extends 'layout.html.twig' %}
{% import '_partials/macros.html.twig' as m %}

{% block title %}Umowa {{ contract.number }}{% endblock %}
{% block active_menu %}contracts{% endblock %}

{% block content %}
    <twig:PageHeader title="Umowa {{ contract.number }}" subtitle="{{ contract.subject }}" back="{{ path('app_contract_index') }}">
        {% if is_granted('CONTRACT_EDIT') %}
            <a href="{{ path('app_contract_edit', {id: contract.id}) }}" class="btn btn-primary">{{ ux_icon('lucide:pencil') }} Edytuj</a>
        {% endif %}
    </twig:PageHeader>

    <div class="grid gap-6 lg:grid-cols-[1fr_360px]">
        <div class="space-y-6">
            <section class="card card-body">
                <h2 class="card-title mb-3">Realizacja</h2>
                {% if realization.target %}
                    <twig:Progress value="{{ realization.quantity }}" max="{{ realization.target }}" />
                    <p class="mt-2 text-lg font-semibold tabular-nums">{{ realization.quantity|qty }} {{ realization.unit }} z {{ realization.target|qty }} {{ realization.unit }} ({{ realization.percent|percent }})</p>
                {% else %}
                    <p class="text-lg font-semibold tabular-nums">{{ realization.quantity|qty }} {{ realization.unit }}</p>
                    <p class="text-sm text-antracyt-500">Umowa bez ilości kontraktowej.</p>
                {% endif %}
                <p class="text-sm text-antracyt-500 mt-1">Na podstawie pozycji {{ realization.invoices }} {{ realization.invoices|plural('faktury', 'faktur', 'faktur') }} powiązanych z umową.{% if realization.skippedItems > 0 %} Pominięto {{ realization.skippedItems }} {{ realization.skippedItems|plural('pozycję', 'pozycje', 'pozycji') }} w innej jednostce.{% endif %}</p>
            </section>

            {% if is_granted('INVOICE_VIEW') %}
                <section class="card">
                    <div class="card-header"><h2 class="card-title">Faktury</h2></div>
                    {% if invoices is empty %}
                        <p class="px-4 py-6 text-sm text-antracyt-500">Żadna faktura nie jest przypisana do tej umowy.</p>
                    {% else %}
                        <div class="table-wrap">
                            <table class="table table-cards">
                                <thead><tr><th>Data</th><th>Numer</th><th class="text-right">Netto</th><th>Status</th></tr></thead>
                                <tbody>
                                    {% for invoice in invoices %}
                                        <tr>
                                            <td data-label="Data" class="tabular-nums">{{ invoice.issueDate|pl_date }}</td>
                                            <td class="card-title-cell"><a href="{{ path('app_invoice_show', {id: invoice.id}) }}">{{ invoice.number }}</a></td>
                                            <td data-label="Netto" class="num">{{ invoice.net|money(invoice.currency) }}</td>
                                            <td data-label="Status"><twig:Badge tone="{{ invoice.status.tone }}">{{ invoice.status.label }}</twig:Badge></td>
                                        </tr>
                                    {% endfor %}
                                </tbody>
                            </table>
                        </div>
                    {% endif %}
                </section>
            {% endif %}
        </div>

        <aside class="space-y-6">
            <section class="card card-body">
                <dl class="dl">
                    <dt>Status</dt><dd><twig:Badge tone="{{ contract.status.tone }}">{{ contract.status.label }}</twig:Badge></dd>
                    <dt>Kontrahent</dt><dd>{% if is_granted('CONTRACTOR_VIEW') %}<a href="{{ path('app_contractor_show', {id: contract.contractor.id}) }}">{{ contract.contractor.name }}</a>{% else %}{{ contract.contractor.name }}{% endif %}</dd>
                    <dt>Rodzaj</dt><dd>{{ contract.kind.label }}</dd>
                    <dt>Zawarta</dt><dd>{{ contract.concludedAt ? contract.concludedAt|pl_date : '—' }}</dd>
                    <dt>Obowiązuje</dt><dd>{{ contract.validFrom ? 'od ' ~ contract.validFrom|pl_date : '' }} {% if contract.validTo %}do {{ m.deadline(contract.validTo, 30, not contract.active) }}{% else %}bezterminowo{% endif %}</dd>
                    <dt>Ilość</dt><dd class="tabular-nums">{{ contract.contractedQuantity ? contract.contractedQuantity|qty ~ ' ' ~ (contract.quantityUnit ? contract.quantityUnit.symbol) : '—' }}</dd>
                    <dt>Cena netto</dt><dd class="tabular-nums">{{ contract.price ? contract.price|amount ~ ' zł' ~ (contract.priceUnit ? '/' ~ contract.priceUnit.symbol) : '—' }}</dd>
                    {% if contract.lease %}
                        <dt>Czynsz</dt>
                        <dd class="tabular-nums">{% if contract.rentAmount %}{{ contract.rentAmount|money }} {{ contract.paymentFrequency ? contract.paymentFrequency.label }}{% if contract.yearlyRent %}<span class="block text-antracyt-500">{{ contract.yearlyRent|money }} rocznie</span>{% endif %}{% else %}—{% endif %}</dd>
                        <dt>Następna płatność</dt>
                        <dd>{% set next = contract.nextPaymentDate %}{{ next ? m.deadline(next, 14) : '—' }}</dd>
                    {% endif %}
                </dl>
                {% if contract.qualityTerms %}<h3 class="font-semibold mt-4 mb-1">Warunki jakościowe</h3><p class="text-sm whitespace-pre-line">{{ contract.qualityTerms }}</p>{% endif %}
                {% if contract.notes %}<h3 class="font-semibold mt-4 mb-1">Uwagi</h3><p class="text-sm whitespace-pre-line">{{ contract.notes }}</p>{% endif %}
            </section>

            <section class="card card-body">
                <h2 class="card-title mb-3">Załączniki</h2>
                {% if contract.attachments is empty %}
                    <p class="text-sm text-antracyt-500">Brak załączników.</p>
                {% else %}
                    <ul class="space-y-2">
                        {% for attachment in contract.attachments %}
                            <li class="flex items-center justify-between gap-2 text-sm">
                                <a href="{{ path('app_contract_attachment', {id: attachment.id}) }}" target="_blank" rel="noopener" class="inline-flex items-center gap-2 min-w-0">{{ ux_icon('lucide:paperclip') }}<span class="truncate">{{ attachment.name }}</span></a>
                                {% if is_granted('CONTRACT_EDIT') %}
                                    <form method="post" action="{{ path('app_contract_attachment_delete', {id: attachment.id}) }}" data-turbo-confirm="Usunąć załącznik „{{ attachment.name }}”?">
                                        <input type="hidden" name="_token" value="{{ csrf_token('contract') }}">
                                        <button type="submit" class="btn btn-ghost btn-icon btn-sm" aria-label="Usuń załącznik">{{ ux_icon('lucide:trash-2') }}</button>
                                    </form>
                                {% endif %}
                            </li>
                        {% endfor %}
                    </ul>
                {% endif %}
            </section>
        </aside>
    </div>
{% endblock %}
