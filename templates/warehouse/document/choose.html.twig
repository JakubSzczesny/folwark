{% extends 'layout.html.twig' %}

{% block title %}Nowy dokument{% endblock %}
{% block active_menu %}documents{% endblock %}

{% block content %}
    <twig:PageHeader title="Nowy dokument" subtitle="Wybierz rodzaj dokumentu" back="{{ path('app_document_index') }}" />

    {% if not has_warehouses %}
        <div class="alert alert-warning mb-4">Najpierw dodaj magazyn w <a href="{{ path('admin') }}">słownikach</a>.</div>
    {% endif %}

    <div class="grid gap-3 sm:grid-cols-2 lg:grid-cols-3">
        {% for type in enum_cases('App\\Enum\\DocumentType') %}
            <a href="{{ path('app_document_new', {typ: type.value}) }}" class="card card-body hover:border-zielen-600 transition-colors">
                <span class="text-lg font-semibold text-tekst">{{ type.value }}</span>
                <span class="block text-sm text-antracyt-500">{{ type.shortLabel|capitalize }}</span>
            </a>
        {% endfor %}
    </div>
{% endblock %}
