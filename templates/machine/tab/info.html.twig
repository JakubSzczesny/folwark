{% macro tree(nodes, parent_id, machine, selected, show_all, can_edit) %}
    {% import _self as self %}
    <ul data-parent="{{ parent_id }}" class="{{ parent_id ? 'ml-4 border-l border-szary-200 pl-1' }}">
        {% for node in nodes|filter(n => n.visible) %}
            <li data-id="{{ node.id }}">
                <div class="flex items-center">
                    {% if can_edit %}<span class="drag-handle cursor-grab text-antracyt-300 hover:text-antracyt-500 px-0.5" title="Przeciągnij, aby zmienić kolejność">{{ ux_icon('lucide:grip-vertical', {width: 14, height: 14}) }}</span>{% endif %}
                    {% set url = path('app_machine_show', {id: machine.id, kategoria: node.id, wszystkie: show_all ? 1 : null}) %}
                    <a href="{{ url }}" class="tree-item flex-1 min-w-0 {{ selected and selected.id == node.id ? 'is-active' }}" {% if selected and selected.id == node.id %}aria-current="true"{% endif %} data-table-nav-target="row" data-href="{{ url }}">
                        <span class="truncate flex-1">{{ node.category.name }}</span>
                        {% if node.total %}<span class="text-xs text-antracyt-500 tabular-nums">{{ node.total }}</span>{% endif %}
                        {% if can_edit %}
                            <template data-context-menu>
                                {% import '_partials/context_menu.html.twig' as cm %}
                                {{ cm.link(path('app_machine_info_entry_new', {id: machine.id, kategoria: node.id}), 'Nowy wpis…', 'plus', 'modal') }}
                                {{ cm.link(path('app_machine_info_category_new', {id: machine.id, rodzic: node.id}), 'Podkategoria…', 'folder-plus', 'modal') }}
                                {{ cm.link(path('app_machine_info_category_edit', {id: machine.id, category: node.id}), 'Zmień nazwę…', 'pencil', 'modal') }}
                                {% if node.total == 0 and node.children is empty %}
                                    {{ cm.separator() }}
                                    {{ cm.post(path('app_machine_info_category_delete', {id: machine.id, category: node.id}), 'Usuń kategorię', 'machine-info', 'trash-2', 'Usunąć kategorię „' ~ node.category.name ~ '”?') }}
                                {% endif %}
                            </template>
                        {% endif %}
                    </a>
                </div>
                {% if node.children|filter(n => n.visible) is not empty %}
                    {{ self.tree(node.children, node.id, machine, selected, show_all, can_edit) }}
                {% endif %}
            </li>
        {% endfor %}
    </ul>
{% endmacro %}
{% import _self as macros %}
{% set can_edit = is_granted('MACHINE_EDIT') %}
{% set selected = tree.selected %}

<div class="grid gap-6 lg:grid-cols-[280px_1fr]">
    <aside class="card card-body self-start" data-controller="context-menu">
        <div class="flex items-center justify-between gap-2 mb-2">
            <h2 class="card-title">Kategorie</h2>
            {% if can_edit %}
                <a href="{{ path('app_machine_info_category_new', {id: machine.id}) }}" data-turbo-frame="modal" class="btn btn-ghost btn-sm">{{ ux_icon('lucide:folder-plus') }} Kategoria</a>
            {% endif %}
        </div>
        {% if tree.nodes is empty %}
            <p class="text-sm text-antracyt-500">Nie ma jeszcze kategorii.</p>
        {% else %}
            <div {% if can_edit %}data-controller="sortable" data-sortable-url-value="{{ path('app_machine_info_category_order') }}" data-sortable-token-value="{{ csrf_token('machine-info') }}"{% endif %}>
                {{ macros.tree(tree.nodes, '', machine, selected, show_all, can_edit) }}
            </div>
            <div class="mt-3 text-sm">
                {% if show_all %}
                    <a href="{{ path('app_machine_show', {id: machine.id, kategoria: selected ? selected.id}) }}">Ukryj puste kategorie</a>
                {% elseif tree.hidden > 0 %}
                    <a href="{{ path('app_machine_show', {id: machine.id, kategoria: selected ? selected.id, wszystkie: 1}) }}">Pokaż wszystkie ({{ tree.hidden }} {{ tree.hidden|plural('pusta', 'puste', 'pustych') }})</a>
                {% endif %}
            </div>
        {% endif %}
        {% if can_edit %}
            <a href="{{ path('app_machine_info_copy', {id: machine.id}) }}" data-turbo-frame="modal" class="btn btn-ghost btn-sm mt-3 w-full">{{ ux_icon('lucide:copy') }} Kopiuj z innej maszyny</a>
        {% endif %}
    </aside>

    <div class="min-w-0">
        {% if selected %}
            <div class="flex flex-wrap items-center justify-between gap-2 mb-3">
                <h2 class="text-base font-semibold">{{ selected.category.path }}</h2>
                {% if can_edit %}
                    <div class="flex flex-wrap gap-2">
                        <a href="{{ path('app_machine_info_category_edit', {id: machine.id, category: selected.id}) }}" data-turbo-frame="modal" class="btn btn-ghost btn-sm">{{ ux_icon('lucide:pencil') }} Nazwa</a>
                        <a href="{{ path('app_machine_info_category_new', {id: machine.id, rodzic: selected.id}) }}" data-turbo-frame="modal" class="btn btn-secondary btn-sm">{{ ux_icon('lucide:folder-plus') }} Podkategoria</a>
                        <a href="{{ path('app_machine_info_entry_new', {id: machine.id, kategoria: selected.id}) }}" data-turbo-frame="modal" class="btn btn-primary btn-sm">{{ ux_icon('lucide:plus') }} Wpis</a>
                    </div>
                {% endif %}
            </div>

            {% for section in sections %}
                {% if section.category.id != selected.id %}
                    <h3 class="text-sm font-semibold text-antracyt-500 mt-5 mb-2">{{ section.category.name }}</h3>
                {% endif %}
                {% if section.entries is empty %}
                    {% if sections|length == 1 %}
                        <div class="card">
                            <twig:EmptyState text="Brak wpisów w tej kategorii."
                                actionLabel="{{ can_edit ? 'Dodaj wpis' : null }}"
                                actionUrl="{{ can_edit ? path('app_machine_info_entry_new', {id: machine.id, kategoria: selected.id}) : null }}"
                                data-turbo-frame="modal" />
                        </div>
                    {% endif %}
                {% else %}
                    <div class="grid gap-3 xl:grid-cols-2">
                        {% for entry in section.entries %}
                            {{ include('machine/info/_entry.html.twig') }}
                        {% endfor %}
                    </div>
                {% endif %}
            {% endfor %}
        {% else %}
            <div class="card">
                <twig:EmptyState text="Dodaj pierwszą kategorię informacji, np. „Filtry”." />
            </div>
        {% endif %}
    </div>
</div>
