{% extends 'layout.html.twig' %}
{% import '_partials/macros.html.twig' as m %}

{% block title %}Kontrahenci{% endblock %}
{% block active_menu %}contractors{% endblock %}

{% block content %}
    <twig:PageHeader title="Kontrahenci" subtitle="Kontrahenci z NIP dodają się sami przy fakturach z KSeF.">
        {% if is_granted('CONTRACTOR_EDIT') %}
            <a href="{{ path('app_contractor_new') }}" class="btn btn-primary">{{ ux_icon('lucide:plus') }} Dodaj kontrahenta</a>
        {% endif %}
    </twig:PageHeader>

    <div data-controller="filters">
    {{ include('_partials/filters_toggle.html.twig', {active: text or kind or inactive ? 1 : 0}) }}
    <form method="get" class="filter-bar is-collapsible" data-filters-target="panel" data-controller="autosubmit" data-turbo-action="replace">
        {{ m.sort_fields(sort) }}
        <div class="field flex-1 min-w-[220px] max-w-md">
            <label class="label" for="f-text">Szukaj</label>
            <input id="f-text" type="search" name="szukaj" class="input" value="{{ text }}" placeholder="Nazwa lub NIP" data-action="input->autosubmit#debounced">
        </div>
        <div class="field">
            <label class="label" for="f-kind">Typ</label>
            <select id="f-kind" name="typ" class="select" data-action="autosubmit#submit">
                <option value="">Wszyscy</option>
                {% for k in kinds %}<option value="{{ k.value }}" {{ kind == k ? 'selected' }}>{{ k.label }}</option>{% endfor %}
            </select>
        </div>
        <label class="inline-flex items-center gap-2 cursor-pointer" style="min-height:40px">
            <input type="checkbox" class="checkbox" name="nieaktywni" value="1" {{ inactive ? 'checked' }} data-action="autosubmit#submit">
            Także nieaktywni
        </label>
        {% if text or kind or inactive %}<a href="{{ path('app_contractor_index', {wyczysc: 1}) }}" class="btn btn-ghost">Wyczyść</a>{% endif %}
    </form>
    </div>

    <div class="card">
        {% if pager.items is empty %}
            <twig:EmptyState text="{{ text or kind ? 'Brak kontrahentów spełniających filtry.' : 'Brak kontrahentów. Pojawią się po synchronizacji faktur z KSeF.' }}" />
        {% else %}
            {% set amounts = is_granted('AMOUNTS_VIEW') %}
            {{ include('_partials/pagination.html.twig', {top: true}) }}
            <div class="table-wrap">
                <table class="table table-cards" data-controller="table-nav context-menu" data-action="keydown@window->table-nav#keydown">
                    <thead>
                        <tr>
                            {{ m.sort_th('Nazwa', 'nazwa', sort) }}
                            {{ m.sort_th('NIP', 'nip', sort) }}
                            {{ m.sort_th('Miejscowość', 'miejscowosc', sort) }}
                            {% if amounts %}
                                {{ m.sort_th('Koszty ' ~ year, 'koszty', sort, 'text-right') }}
                                {{ m.sort_th('Przychody ' ~ year, 'przychody', sort, 'text-right') }}
                            {% endif %}
                            {{ m.sort_th('Ostatnia faktura', 'faktura', sort) }}
                            {{ m.sort_th('Aktywne umowy', 'umowy', sort, 'text-right') }}
                        </tr>
                    </thead>
                    <tbody>
                        {% for contractor in pager.items %}
                            {% set t = totals[contractor.id] ?? null %}
                            <tr data-table-nav-target="row" data-href="{{ path('app_contractor_show', {id: contractor.id}) }}" data-action="click->table-nav#click">
                                <td class="card-title-cell">
                                    <template data-context-menu>
                                        {% import '_partials/context_menu.html.twig' as cm %}
                                        {% if is_granted('INVOICE_VIEW') %}{{ cm.link(path('app_contractor_show', {id: contractor.id, zakladka: 'faktury'}), 'Faktury', 'receipt-text') }}{% endif %}
                                        {{ cm.link(path('app_contractor_show', {id: contractor.id, zakladka: 'zakupy'}), 'Zakupy', 'shopping-cart') }}
                                        {{ cm.link(path('app_contractor_show', {id: contractor.id, zakladka: 'umowy'}), 'Umowy', 'file-signature') }}
                                        {% if is_granted('CALENDAR_VIEW') %}{{ cm.link(path('app_contractor_show', {id: contractor.id, zakladka: 'kalendarz'}), 'Kalendarz', 'calendar') }}{% endif %}
                                        {% if is_granted('CALENDAR_EDIT') %}{{ cm.link(path('app_calendar_new', {kontrahent: contractor.id}), 'Nowe wydarzenie…', 'plus', 'modal') }}{% endif %}
                                        {% if is_granted('CONTRACT_EDIT') %}{{ cm.link(path('app_contract_new', {kontrahent: contractor.id}), 'Nowa umowa', 'plus') }}{% endif %}
                                        {% if is_granted('CONTRACTOR_EDIT') %}{{ cm.separator() }}{{ cm.link(path('app_contractor_edit', {id: contractor.id}), 'Edytuj dane', 'pencil') }}{% endif %}
                                    </template>
                                    <a href="{{ path('app_contractor_show', {id: contractor.id}) }}" class="text-tekst hover:text-zielen-600">{{ contractor.displayName }}</a>
                                    {% if contractor.shortName %}<span class="block text-xs text-antracyt-500 font-normal">{{ contractor.name }}</span>{% endif %}
                                    {% if not contractor.active %}<twig:Badge tone="neutral">nieaktywny</twig:Badge>{% endif %}
                                </td>
                                <td data-label="NIP" class="tabular-nums">{{ contractor.nip ?? '—' }}</td>
                                <td data-label="Miejscowość">{{ contractor.city }}</td>
                                {% if amounts %}
                                    <td data-label="Koszty {{ year }}" class="num">{{ t and t.cost ? t.cost|money : '—' }}</td>
                                    <td data-label="Przychody {{ year }}" class="num">{{ t and t.income ? t.income|money : '—' }}</td>
                                {% endif %}
                                <td data-label="Ostatnia faktura" class="tabular-nums">{{ t and t.last ? date(t.last)|pl_date : '—' }}</td>
                                <td data-label="Aktywne umowy" class="num">{{ contract_counts[contractor.id] ?? 0 }}</td>
                            </tr>
                        {% endfor %}
                    </tbody>
                </table>
            </div>
            {{ include('_partials/pagination.html.twig') }}
        {% endif %}
    </div>
{% endblock %}
