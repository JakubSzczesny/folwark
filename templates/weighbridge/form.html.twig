{% extends 'layout.html.twig' %}

{% block title %}{{ title }}{% endblock %}
{% block active_menu %}weighbridge{% endblock %}

{% block content %}
    <twig:PageHeader title="{{ title }}" back="{{ path('app_weighbridge') }}" />

    <div class="card card-body max-w-2xl">
        {{ form_start(form) }}
            {{ form_widget(form) }}
            <datalist id="weighbridge-groups">
                {% for group in groups %}<option value="{{ group }}">{% endfor %}
            </datalist>
            <div class="flex flex-wrap gap-2">
                <button type="submit" class="btn btn-primary">Zapisz</button>
                <a href="{{ path('app_weighbridge') }}" class="btn btn-ghost">Anuluj</a>
            </div>
        {{ form_end(form) }}

        {% if task.id %}
            <hr class="my-6 border-szary-200">
            <form method="post" action="{{ path('app_weighbridge_delete', {id: task.id}) }}" data-turbo-confirm="Usunąć ten punkt z listy?">
                <input type="hidden" name="_token" value="{{ csrf_token('weighbridge') }}">
                <button type="submit" class="btn btn-danger">{{ ux_icon('lucide:trash-2') }} Usuń punkt</button>
            </form>
        {% endif %}
    </div>
{% endblock %}
