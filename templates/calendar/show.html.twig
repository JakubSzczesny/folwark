{% extends modal ? 'calendar/_frame.html.twig' : 'layout.html.twig' %}

{% block title %}{{ event.title }} · Kalendarz{% endblock %}
{% block active_menu %}calendar{% endblock %}

{% block modal %}
    <twig:Modal title="{{ event.title }}">
        {{ include('calendar/_details.html.twig') }}
    </twig:Modal>
{% endblock %}

{% block content %}
    <twig:PageHeader title="{{ event.title }}" back="{{ path('app_calendar_index', {miesiac: occurrence|date('Y-m')}) }}" backLabel="Kalendarz" />
    <div class="card card-body max-w-2xl">
        {{ include('calendar/_details.html.twig') }}
    </div>
{% endblock %}
